# DeskWell needs no environment variables or API keys to build or run.
# Everything works offline. These are only for optional release signing in CI
# (set them as GitHub Actions secrets, never commit real values):
#
# APPLE_CERTIFICATE=            # base64 .p12 Developer ID Application certificate
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_SIGNING_IDENTITY=       # "Developer ID Application: Name (TEAMID)"
# APPLE_ID=                     # for notarization
# APPLE_PASSWORD=               # app-specific password
# APPLE_TEAM_ID=
#
# A future optional cloud TTS provider would read its key from the app's own
# settings at runtime, never from the build.
