{
  "manifest_version": 3,
  "name": "DeskWell",
  "short_name": "DeskWell",
  "description": "Your Personal Desk Wellness Assistant: water, movement, eye-rest and stretch reminders with voice. Free and open source.",
  "version": "0.1.0",
  "author": "Md Ashik Ali",
  "homepage_url": "https://github.com/tlakib/deskwell",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "DeskWell", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["alarms", "storage", "notifications", "idle", "tts", "offscreen"]
}
