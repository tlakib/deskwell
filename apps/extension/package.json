{
  "name": "@deskwell/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../../scripts/copy-voices.mjs public && node -e \"require('fs').copyFileSync('../../assets/brand/icon.png','public/icon.png')\"",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@deskwell/domain": "workspace:*",
    "@deskwell/ui": "workspace:*",
    "idb": "8.0.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@types/chrome": "0.1.12",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "fake-indexeddb": "6.2.2",
    "jszip": "3.10.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
