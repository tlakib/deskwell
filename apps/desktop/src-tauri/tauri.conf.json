{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskWell",
  "version": "0.1.0",
  "identifier": "io.github.tlakib.deskwell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskWell",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "center": true
      },
      {
        "label": "panel",
        "title": "DeskWell",
        "url": "index.html#/panel",
        "width": 360,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      },
      {
        "label": "popup",
        "title": "DeskWell reminder",
        "url": "index.html#/popup",
        "width": 400,
        "height": 300,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Md Ashik Ali",
    "copyright": "Copyright (c) 2026 Md Ashik Ali. MIT License.",
    "category": "Productivity",
    "shortDescription": "Your Personal Desk Wellness Assistant",
    "longDescription": "DeskWell is a free, open-source desk wellness assistant: water, movement, eye-rest, stretching and custom reminders with voice, right from your system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
